      "icon": "ListView",
      "author": {
        "name": "Lettland",
        "github": "lettland",
        "url": "https://github.com/lettland"
      },
      "source": {
        "git": {
          "url": "https://github.com/lettland/bb-plugins.git",
          "subdir": "plugins/thread-list-fork",
          "range": "0.x",
          "tagPrefix": "thread-list-fork/"
        }
      }
    },
    {
      "id": "triage",
      "displayName": "Triage",
      "description": "Keep agent tasks, progress, and work that needs your attention in one board.",
      "icon": "ListTodo",
      "author": {
        "name": "Mayank Bansal"
      },
      "source": {
        "git": {
          "url": "https://github.com/lettland/bb-plugins.git",
          "subdir": "plugins/triage",
          "range": "0.x",
          "tagPrefix": "triage/"
        }
      }
    },
    {
      "id": "typesafe",
      "displayName": "TypeSafe decisions",
      "description": "Typed Choice/Noul/Score decisions from TypeSafe's Jev model for agents — a typesafe_decide tool plus optional opening-request triage.",
      "icon": "Scale",
      "author": {
        "name": "Lettland",
        "github": "lettland",
        "url": "https://github.com/lettland"
      },
      "source": {
        "git": {
          "url": "https://github.com/lettland/bb-plugins.git",
          "subdir": "plugins/typesafe",
          "range": "0.x",
          "tagPrefix": "typesafe/"
