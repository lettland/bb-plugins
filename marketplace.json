{
  "$schema": "https://getbb.app/schemas/marketplace.schema.json",
  "schemaVersion": 1,
  "name": "lettland-plugins",
  "displayName": "Lettland plugins",
  "description": "Lettland's bb plugins: agent hooks, auto review, devkit and more.",
  "plugins": [
    {
      "id": "agent-hooks",
      "displayName": "Agent hooks",
      "description": "bb owns the tool-call safety hooks and installs them into each provider; providers only execute them.",
      "icon": "ShieldCheck",
      "author": {
        "name": "Lettland",
        "github": "lettland",
        "url": "https://github.com/lettland"
      },
      "source": {
        "git": {
          "url": "https://github.com/lettland/bb-plugins.git",
          "subdir": "plugins/agent-hooks",
          "range": "0.x",
          "tagPrefix": "agent-hooks/"
        }
      }
    },
    {
      "id": "aislop",
      "displayName": "aislop",
      "description": "Run the aislop quality scan from bb, scoped by default to what the current branch changed against its root.",
      "icon": "ScanSearch",
      "author": {
        "name": "Lettland",
        "github": "lettland",
        "url": "https://github.com/lettland"
      },
      "source": {
        "git": {
          "url": "https://github.com/lettland/bb-plugins.git",
          "subdir": "plugins/aislop",
          "range": "0.x",
          "tagPrefix": "aislop/"
        }
      }
    },
    {
      "id": "auto-review",
      "displayName": "Auto review",
      "description": "Review, commit, and locally merge into a personal mainline (e.g. master) the changes an agent made this turn.",
      "icon": "GitMerge",
      "author": {
        "name": "Lettland",
        "github": "lettland",
        "url": "https://github.com/lettland"
      },
      "source": {
        "git": {
          "url": "https://github.com/lettland/bb-plugins.git",
          "subdir": "plugins/auto-review",
          "range": "0.x",
          "tagPrefix": "auto-review/"
        }
      }
    },
    {
      "id": "devkit",
      "displayName": "devkit",
      "description": "Locate and load devkit's skill library on demand, plus calibrated multi-perspective review.",
      "icon": "Sparkles",
      "author": {
        "name": "Lettland",
        "github": "lettland",
        "url": "https://github.com/lettland"
      },
      "source": {
        "git": {
          "url": "https://github.com/lettland/bb-plugins.git",
          "subdir": "plugins/devkit",
          "range": "0.x",
          "tagPrefix": "devkit/"
        }
      }
    },
    {
      "id": "github-fork",
      "displayName": "GitHub",
      "description": "Browse GitHub issues and pull requests in BB, then send them to agents.",
      "icon": "Github",
      "author": {
        "name": "Lettland",
        "github": "lettland",
        "url": "https://github.com/lettland"
      },
      "source": {
        "git": {
          "url": "https://github.com/lettland/bb-plugins.git",
          "subdir": "plugins/github-fork",
          "range": "0.x",
          "tagPrefix": "github-fork/"
        }
      }
    },
    {
      "id": "model-instructions",
      "displayName": "Model instructions",
      "description": "Custom instructions and skills per directory, project, provider and model, optionally only for top-level or only for child threads, plus a Claude Code profile per directory. A save that would push any known thread past bb's 4096-character limit is rejected.",
      "icon": "SlidersHorizontal",
      "author": {
        "name": "Lettland",
        "github": "lettland",
        "url": "https://github.com/lettland"
      },
      "source": {
        "git": {
          "url": "https://github.com/lettland/bb-plugins.git",
          "subdir": "plugins/model-instructions",
          "range": "0.x",
          "tagPrefix": "model-instructions/"
        }
      }
    },
    {
      "id": "project-queue",
      "displayName": "Project queue",
      "description": "Start a new thread only when no other thread in its project is running.",
      "icon": "Clock",
      "author": {
        "name": "Lettland",
        "github": "lettland",
        "url": "https://github.com/lettland"
      },
      "source": {
        "git": {
          "url": "https://github.com/lettland/bb-plugins.git",
          "subdir": "plugins/project-queue",
          "range": "0.x",
          "tagPrefix": "project-queue/"
        }
      }
    },
    {
      "id": "provider-queue",
      "displayName": "Provider queue",
      "description": "Start a queued thread only when its provider has a free slot.",
      "icon": "ListOrdered",
      "author": {
        "name": "Lettland",
        "github": "lettland",
        "url": "https://github.com/lettland"
      },
      "source": {
        "git": {
          "url": "https://github.com/lettland/bb-plugins.git",
          "subdir": "plugins/provider-queue",
          "range": "0.x",
          "tagPrefix": "provider-queue/"
        }
      }
    },
    {
      "id": "shared-runtime",
      "displayName": "Shared Runtime",
      "description": "Typed, project-confined shared container runtime for BB worktrees, driven by a project's .bb-runtime.json, in the repository or the host project directory",
      "icon": "Container",
      "author": {
        "name": "Lettland",
        "github": "lettland",
        "url": "https://github.com/lettland"
      },
      "source": {
        "git": {
          "url": "https://github.com/lettland/bb-plugins.git",
          "subdir": "plugins/shared-runtime",
          "range": "0.x",
          "tagPrefix": "shared-runtime/"
        }
      }
    },
    {
      "id": "tasks-fork",
      "displayName": "Tasks",
      "description": "Plan and track work in BB, delegate tasks to agents, and keep task context connected to worker threads.",
      "icon": "ListTodo",
      "author": {
        "name": "Lettland",
        "github": "lettland",
        "url": "https://github.com/lettland"
      },
      "source": {
        "git": {
          "url": "https://github.com/lettland/bb-plugins.git",
          "subdir": "plugins/tasks-fork",
          "range": "0.x",
          "tagPrefix": "tasks-fork/"
        }
      }
    },
    {
      "id": "thread-list-fork",
      "displayName": "Thread list",
