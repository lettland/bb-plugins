{
  "name": "@lettland/bb-plugin-devkit",
  "version": "0.1.12",
  "type": "module",
  "description": "devkit's skill library, locator, and calibrated review — as a provider-neutral bb plugin.",
  "license": "BSD-2-Clause AND Apache-2.0 AND MIT",
  "engines": {
    "bb": ">=0.0"
  },
  "bb": {
    "name": "devkit",
    "description": "Locate and load devkit's skill library on demand, plus calibrated multi-perspective review.",
    "branding": {
      "icon": "Sparkles"
    },
    "server": "./server.ts",
    "skills": [
      "skills",
      "skills-generated"
    ]
  },
  "keywords": [
    "bb-plugin"
  ],
  "files": [
    "server.ts",
    "src",
    "skills",
    "skills-generated",
    "content",
    "dist",
    "THIRD_PARTY_NOTICES.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build:data": "node scripts/build-index.mjs",
    "build": "node scripts/build-index.mjs && bb plugin build",
    "prepack": "node scripts/build-index.mjs && bb plugin build",
    "test": "vitest run --config vitest.config.ts",
    "test:coverage": "vitest run --config vitest.config.ts --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.5.9",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.20.4",
    "@vitest/coverage-v8": "^4.1.11",
    "js-yaml": "^4.3.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
