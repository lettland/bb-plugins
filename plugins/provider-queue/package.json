{
  "name": "@lettland/bb-plugin-provider-queue",
  "version": "0.1.3",
  "type": "module",
  "description": "Start a queued thread only when its provider has a free slot.",
  "license": "MIT",
  "engines": {
    "bb": ">=0.46.1",
    "bbPluginSdk": ">=0.6.49"
  },
  "bb": {
