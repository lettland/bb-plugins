{
  "name": "@lettland/bb-plugin-auto-review",
  "version": "0.1.24",
  "type": "module",
  "description": "Review, commit, and locally merge into a personal mainline (e.g. master) the changes an agent made this turn.",
  "license": "BSD-2-Clause",
  "engines": {
    "bb": ">=0.38",
    "bbPluginSdk": ">=0.4.6"
  },
  "bb": {
    "name": "Auto review",
    "description": "Review, commit, and locally merge into a personal mainline (e.g. master) the changes an agent made this turn.",
    "branding": {
      "icon": "GitMerge"
    },
    "server": "./server.ts",
    "app": "./app.tsx",
    "skills": [
      "skills"
    ]
  },
  "keywords": [
    "bb-plugin"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "env -u BB_CLI bb plugin build .",
    "test": "vitest run --config vitest.config.ts",
    "test:coverage": "vitest run --config vitest.config.ts --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.5.9",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@vitest/coverage-v8": "^4.1.11",
    "better-sqlite3": "^13.0.3",
    "cron-parser": "^5.5.0",
    "hono": "^4.13.9",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
