{
  "name": "@lettland/bb-plugin-dir-skills",
  "version": "0.2.8",
  "description": "Inject bb skills into a thread only when its workspace lives under a configured directory, for every provider.",
  "license": "BSD-2-Clause",
  "type": "module",
  "files": [
    "server.ts",
    "app.tsx",
    "rpc-contract.ts",
    "scopes.ts",
    "profile.ts",
    "detect.ts",
    "setup.ts",
    "skills",
    "scopes.json",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.json && vitest run --config vitest.config.ts",
    "test:coverage": "tsc -p tsconfig.json && vitest run --config vitest.config.ts --coverage",
    "build": "bb plugin build"
  },
  "engines": {
    "bb": ">=0.44",
    "bbPluginSdk": ">=0.5.15"
  },
  "bb": {
    "name": "Directory skills",
    "description": "Skills scoped to a directory tree: a skill listed in scopes.json is injected only into threads whose workspace (or project checkout) is under that directory. A scope can also switch Claude Code threads to its own Claude profile. Skills work for every provider.",
    "branding": {
      "icon": "FolderTree"
    },
    "server": "./server.ts",
    "app": "./app.tsx",
    "skills": [
      "skills"
    ]
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.6.79",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^4.1.11",
    "better-sqlite3": "^13.0.3",
    "cron-parser": "^5.10.2",
    "hono": "^4.13.13",
    "jsdom": "^27.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "zod": "^4.3.6"
  }
}
